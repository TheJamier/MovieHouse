  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- \xBFCu\xE1l es la ense\xF1anza?\n- \xBFHabla sobre ansiedad o estr\xE9s?\n\n7.
    CANELO EL PERRO FIEL\n- \xBFCanelo est\xE1 basado en hechos reales?\n- \xBFQu\xE9
    le pasa al due\xF1o?\n- \xBFPor qu\xE9 espera tanto tiempo?\n- \xBFCu\xE1l es
    el mensaje del corto?\n- \xBFPor qu\xE9 es tan emotivo?\n\n8. VIDEO INCLUSION\n-
    \xBFPor qu\xE9 rechazan al erizo?\n- \xBFQu\xE9 representan las p\xFAas?\n- \xBFCu\xE1l
    es la moraleja?\n- \xBFQu\xE9 ense\xF1a el corto?\n- \xBFPor qu\xE9 habla de
    inclusi\xF3n?\n\n9. DESTINO DE PAPEL\n- \xBFDe qu\xE9 trata Destino de papel?\n-
    \xBFQu\xE9 significan los aviones de papel?\n- \xBFPor qu\xE9 est\xE1 en blanco
    y negro?\n- \xBFEs una historia de amor?\n- \xBFQu\xE9 representa el destino?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
