  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "4. PREGUNTAS GENERALES SOBRE PELICULAS\n- \xBFQu\xE9 pel\xEDculas hay
    disponibles?\n- \xBFCu\xE1ntos cortometrajes hay?\n- \xBFCu\xE1l me recomiendas?\n-
    \xBFCu\xE1l dura menos?\n- \xBFCu\xE1l es el m\xE1s triste?\n- \xBFCu\xE1l es
    el m\xE1s bonito visualmente?\n- \xBFHay alg\xFAn corto rom\xE1ntico?\n- \xBFCu\xE1l
    habla de salud mental?\n- \xBFCu\xE1l es m\xE1s emocional?\n- \xBFCu\xE1l es
    el m\xE1s relajado?\n\n\n5. VIDEO LGBT\n- \xBFDe qu\xE9 trata Video LGBT?\n-
    \xBFCu\xE1l es el mensaje del corto?\n- \xBFQu\xE9 significa el coraz\xF3n?\n-
    \xBFPor qu\xE9 no tiene di\xE1logos?\n- \xBFEs una historia rom\xE1ntica?\n-
    \xBFQu\xE9 intenta transmitir?\n\n6. SOBRE CARGA\n- \xBFDe qu\xE9 trata Sobre
    carga?\n- \xBFQu\xE9 representa el monstruo?\n- \xBFPor qu\xE9 el personaje se
    agota?\n"
  m_isRightToLeft: 0
